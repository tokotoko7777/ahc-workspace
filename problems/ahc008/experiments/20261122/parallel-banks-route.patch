+ array<int,V> braceDist(int start,const bitset<V>& extra={})const{
+  array<int,V> d;d.fill(999);
+  int q[V],n=1;q[0]=start;d[start]=0;
+  for(int i=0;i<n;i++)for(int v:nb[q[i]])if(v>=0&&!braceSet[v]&&!extra[v]&&d[v]==999)
+   d[v]=d[q[i]]+1,q[n++]=v;
+  return d;
+ }
+ void planBraceRoutes(){
+  if(!bankRouteMode)return;
+  for(int p:bankWalls)braceSet[p]=1;
+  using route_makespan::Cost;
+  vector<array<int,V>> approach;
+  for(int h:humans)approach.push_back(braceDist(h));
+  vector<array<int,V>> known(V);
+  bitset<V> got;
+  for(int mode=0;mode<16;mode++){
+   vector<pair<int,int>> passes;
+   if(mode&1){
+    for(int i=0;i<7;i++)for(int j=0;j<3;j++)passes.emplace_back((i&1)?2-j:j,(mode&4)?6-i:i);
+   }else{
+    for(int j=0;j<3;j++)for(int i=0;i<7;i++)passes.emplace_back((mode&4)?2-j:j,(j&1)?6-i:i);
+   }
+   if(mode&8)reverse(passes.begin(),passes.end());
+   vector<BraceTask> list;
+   vector<Cost> work,walk;
+   for(int z=0;z<int(passes.size());z++){
+    auto [j,i]=passes[z];int r=i==6?25:3+4*i;
+    for(int k=0;k<4;k++){
+     int col=bankShift+7*j+2+(((z&1)^bool(mode&2))?3-k:k);
+     int p=bp(r,col);
+     list.push_back({p,i==6?-1:bp(r-1,col),bp(r+1,col)});
+     work.push_back(i==6?1:2);
+    }
+   }
+   for(int i=0;i<int(list.size());i++){
+    int p=list[i].stance;
+    if(!got[p])got[p]=1,known[p]=braceDist(p);
+    walk.push_back(i+1==int(list.size())?0:known[p][list[i+1].stance]);
+   }
+   vector<vector<Cost>> travel(humans.size());
+   for(int i=0;i<int(humans.size());i++)for(auto a:list)travel[i].push_back(approach[i][a.stance]);
+   auto plan=route_makespan::solve(work,walk,travel);
+   if(routeNominal<0||plan.makespan<routeNominal){
+    routeNominal=plan.makespan;routeRecipe=mode;
+    for(auto &r:routes)r.clear();
+    for(auto [k,l,r]:plan.segments)routes[k].assign(list.begin()+l,list.begin()+r);
+   }
+  }
+ }
+ void routeBraceActions(bitset<V>&build,bitset<V>&moveTo){
+  if(!bankRouteMode)return;
+  bitset<V> unavailable=build;
+  for(int p=0;p<V;p++)if(wall[p])unavailable[p]=1;
+  for(int i=0;i<int(humans.size());i++)if(act[i]=='.'&&
+     (zonesActive?!zoneUsed[i]:find(laneCrew.begin(),laneCrew.end(),i)==laneCrew.end())){
+   auto &k=curRoute[i];
+   for(;k<int(routes[i].size());k++){
+    auto a=routes[i][k];
+    bool empty=true;
+    for(int p:{a.up,a.down})if(p>=0&&!wall[p]&&!build[p])empty=false;
+    if(empty)continue;
+    int h=humans[i];
+    if(h!=a.stance){
+     auto d=braceDist(a.stance,unavailable);
+     int best=999,q=-1;
+     for(int v:nb[h])if(v>=0&&!braceSet[v]&&!unavailable[v]&&d[v]<best)best=d[v],q=v;
+     if(q<0){routeBlocked++;continue;}
+     act[i]=MOVE[dir(h,q)];moveTo[q]=1;routeSteps++;
+     break;
+    }
+    for(int p:{a.up,a.down})if(p>=0&&!wall[p]&&!build[p]&&!block[p]&&!moveTo[p]){
+     act[i]=BUILD[dir(h,p)];build[p]=1;unavailable[p]=1;routeBuilt++;break;
+    }
+    if(act[i]!='.')break;
+    // A blocked stand is allowed to finish any feasible half first,
+    // and then passed over. Idle workers can take old greedy repair jobs.
+    routeBlocked++;
+   }
+  }
+ }
