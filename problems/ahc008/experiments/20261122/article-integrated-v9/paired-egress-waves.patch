+ struct WaveTask{int wall,stance;};
+ struct WaveSide{int actor=-1,exit=-1,cost=0;vector<WaveTask> work;};
+ struct WaveBank{int bank=-1,first=-1;array<WaveSide,2> side;bool active=false;};
+ vector<WaveBank> waveSelected;
+ bitset<V> waveFoot;
+ int waveDeadline=0,waveNominal=-1;
