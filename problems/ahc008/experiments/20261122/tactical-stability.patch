+ double gateStability(Bitboard::Rows real, const vector<pair<int,int>>& moves, const vector<int>& after){
+  auto closed=real;
+  bitset<V> forbidden;
+  for(auto [person,p]:moves){
+   closed[p/S]&=~(1u<<(p%S));forbidden[p]=true;
+   for(int q:nb[p])if(q>=0)forbidden[q]=true;
+  }
+  auto possible=closed;
+  Bitboard::Rows patch{},mobile{};
+  int area;
+  while(Bitboard::pop_first(possible,patch,area)){
+   bool select=false;
+   for(int i=0;i<(int)humans.size();i++)if(!captiveHuman(i)){
+    int q=after[i];if((patch[q/S]>>(q%S))&1u){select=true;break;}
+   }
+   if(select)for(int i=0;i<S;i++)mobile[i]|=patch[i];
+  }
+  auto on=[&](const Bitboard::Rows &q,int p){return (q[p/S]>>(p%S))&1u;};
+  double probability=1.;
+  for(auto pet:pets){
+   int steps=min(4,(pet.t==1?1:pet.t==3?3:2)+GATE_EXTRA_STEPS);
+   bool close=false;
+   for(auto [person,p]:moves)if(md(p,pet.p)<=steps+1){close=true;break;}
+   if(!close)continue; // Cannot change side through a prospective gate or make it illegal.
+   bool side=on(mobile,pet.p);
+   array<double,V> d{},nx{};
+   array<int,V> seen{};
+   vector<int> frontier{pet.p},next;
+   d[pet.p]=1.;
+   for(int t=1;t<=steps;t++){
+    next.clear();
+    for(int p:frontier){
+     int degree=0;
+     for(int q:nb[p])if(q>=0&&on(real,q))degree++;
+     if(!degree){
+      if(seen[p]!=t)seen[p]=t,nx[p]=0.,next.push_back(p);
+      nx[p]+=d[p];
+     }else for(int q:nb[p])if(q>=0&&on(real,q)){
+      if(seen[q]!=t)seen[q]=t,nx[q]=0.,next.push_back(q);
+      nx[q]+=d[p]/degree;
+     }
+    }
+    d.swap(nx);frontier.swap(next);
+   }
+   double pass=0.;
+   for(int p:frontier)if(!forbidden[p]&&on(mobile,p)==side)pass+=d[p];
+   probability*=pass;
+  }
+  return probability;
+ }
