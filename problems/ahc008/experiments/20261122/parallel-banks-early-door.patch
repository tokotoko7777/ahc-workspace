+   bool bodyHuman=any_of(humans.begin(),humans.end(),[&](int p){return find(x.inner.begin(),x.inner.end(),p)!=x.inner.end();});
+   if(!wall[reservNear]||wall[reservFar]||turn>reservExpiry||!prey||bodyHuman){
+    reservBank=-1;
+   }else {
+    int w=reservWorker,h=humans[w];
+    if(act[w]!='.')return;
+    if(h==reservStance&&!block[reservFar]&&!moveTo[reservFar]){
+     act[w]=BUILD[dir(h,reservFar)];held[w]=1;build[reservFar]=1;
+    }else{
+     auto [d,p]=bankOuterStep(h,reservStance,x);
+     if(d<=2)go(w,p,h);
+    }
+    return;
+   }
+  }
+  if(turn>bankRelease-5)return;
+  int best=-1,id=-1,left=-1,right=-1,first=-1,far=-1,stance=-1,path=-1,eta=-1;
+  for(int i=0;i<int(banks.size());i++){
+   auto &x=banks[i];
+   if(!ready[i]||wall[x.g]||wall[x.k]||build[x.g]||build[x.k])continue;
+   if(any_of(humans.begin(),humans.end(),[&](int p){return find(x.inner.begin(),x.inner.end(),p)!=x.inner.end();}))continue;
+   int count=0;for(auto p:pets)count+=p.t<=3&&(p.p==x.inner[1]||p.p==x.inner[2]);
+   if(!count)continue;
+   for(int z=0;z<2;z++){
+    int a=z?x.h:x.l,b=z?x.l:x.h,g=z?x.k:x.g,k=z?x.g:x.k;
+    if(block[g]||moveTo[g])continue;
+    int who=-1;
+    for(int j=0;j<int(humans.size());j++)if(act[j]=='.'&&humans[j]==a){who=j;break;}
+    if(who<0)continue;
+    for(int j=0;j<int(humans.size());j++)if(j!=who&&act[j]=='.'){
+     auto [d,p]=bankOuterStep(humans[j],b,x);
+     if(d>2||(d==0&&!block[k])||(d>0&&build[p]))continue;
+     int value=100*count-10*d-(block[k]?2:0);
+     if(value<=best)continue;
+     best=value;id=i;left=who;right=j;first=g;far=k;stance=b;path=p;eta=d;
+    }
+   }
+  }
+  if(id<0)return;
+  reservBank=id;reservNear=first;reservFar=far;reservStance=stance;reservWorker=right;reservExpiry=turn+eta+2;
+  act[left]=BUILD[dir(humans[left],first)];build[first]=1;held[left]=1;
+  go(right,path,humans[right]);
+ }
