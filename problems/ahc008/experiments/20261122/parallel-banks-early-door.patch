+ pair<int,int> bankOuterStep(int h,int stance,const TubeBank& tube)const{
+  if(h==stance)return {0,h};
+  int d[V],q[V],first[V],n=1;fill(d,d+V,-1);q[0]=h;d[h]=0;first[h]=h;
+  for(int i=0;i<n;i++)for(int v:nb[q[i]])if(v>=0&&!wall[v]&&v!=tube.g&&v!=tube.k&&
+                    find(tube.inner.begin(),tube.inner.end(),v)==tube.inner.end()&&d[v]<0){
+   d[v]=d[q[i]]+1;first[v]=i==0?v:first[q[i]];
+   if(v==stance)return {d[v],first[v]};
+   q[n++]=v;
+  }
+  return {999,-1};
+ }
