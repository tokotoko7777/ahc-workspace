+ double bankDirectionGain(int i,const TubeBank& x){
+  if(!bankDirection||turn<bankStaffTurn||pets[i].t<4)return 1.;
+  int current=pets[i].p,start=petBefore[i],first=petFirst[i];
+  if(start==first)return 1.;
+  int a=bankRot?start/S:start%S,b=bankRot?first/S:first%S,c=bankRot?current/S:current%S;
+  int rr=bankRot?current%S:current/S,pr=bankRot?start%S:start/S;
+  if(abs(rr-x.r)>1||abs(pr-x.r)>1||a==b)return 1.;
+  int g=bankRot?x.g/S:x.g%S,h=bankRot?x.k/S:x.k%S;
+  if(min(abs(c-g),abs(c-h))>3||min(abs(a-g),abs(a-h))>3)return 1.;
+  int middle=g+h;
+  if((2*a-middle)*(2*b-middle)<0)return 1.;
+  int d=abs(2*a-middle),e=abs(2*b-middle);
+  if(d==e)return 1.;
+  dirSignals[d>e?0:1]++;
+  return d>e?1.6:.5;
+ }
