+   // unrelated segment after the planned sweep has skipped a blocker.
+   auto d=starterD(h,no);int best=999,pick=-1,st=-1;
+   for(int p:bankWalls)if(starterWalls[p]&&!wall[p]&&!block[p]&&!moveTo[p]&&!build[p])
+    for(int q:nb[p])if(q>=0&&!braceOnly[q]&&!no[q]&&d[q]<best)best=d[q],pick=p,st=q;
+   if(pick>=0){if(h==st)buildCell(pick);else move(st);}
+  }
+  return true;
+ }
