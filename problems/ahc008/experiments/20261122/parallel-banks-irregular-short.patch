+ pair<int,int> irrWalk(int from,int goal,const bitset<V>& no,const array<unsigned char,V>& closed,int cap=4)const{
+  if(closed[goal]||no[goal])return {99,-1};
+  if(from==goal)return {0,goal};
+  int q[V],d[V],first[V],n=1;fill(d,d+V,-1);q[0]=from;d[from]=0;
+  for(int a=0;a<n;a++)if(d[q[a]]<cap)
+   for(int p:nb[q[a]])if(p>=0&&!closed[p]&&!no[p]&&d[p]<0){
+    d[p]=d[q[a]]+1;first[p]=a==0?p:first[q[a]];
+    if(p==goal)return {d[p],first[p]};
+    q[n++]=p;
+   }
+  return {99,-1};
+ }
+ static bool irregShape(const vector<int>& cells){
+  if(cells.size()<4||cells.size()>24)return false;
+  int l=30,r=-1,u=30,d=-1;
+  for(int x:cells)l=min(l,x/S),r=max(r,x/S),u=min(u,x%S),d=max(d,x%S);
+  return (r-l+1)*(d-u+1)!=int(cells.size());
+ }
