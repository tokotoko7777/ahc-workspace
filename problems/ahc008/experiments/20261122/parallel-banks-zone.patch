+   int r=bankRot?a%S:a/S,dr=bankRot?dest%S:dest/S;
+   if(col==dcol&&(dr==13||((r>=14)==(dr>=14))))continue;
+   int q=workers[w].bfs.first_step(dest);
+   if(q>=0&&q!=a&&!build[q])act[w]=MOVE[dir(a,q)],moveTo[q]=1;
+  }
+ }
