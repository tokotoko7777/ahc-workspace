+ void continueBridge(bitset<V>& used,bitset<V>& moveTo){
+  if(crossing.actor<0)return;
+  auto &c=crossing;
+  const int h=c.actor,x=humans[h];
+  int k=find(c.route.begin(),c.route.end(),x)-c.route.begin();
+  if(k==8||k==7||(k==0&&c.retreat)){
+   bridgeReport.push_back({turn,k==7?1:2,h,c.tube,x,x,0});
+   c.actor=c.tube=-1;return;
+  }
+  if(!c.retreat&&any_of(c.route.begin()+k+1,c.route.end(),[&](int p){return wall[p];})){
+   if(k==0){
+    bridgeReport.push_back({turn,2,h,c.tube,x,x,0});
+    c.actor=c.tube=-1;return;
+   }
+   c.retreat=true;
+  }
+  int p=c.route[k+(c.retreat?-1:1)];
+  used[h]=true;
+  if(!wall[p]){
+   act[h]=MOVE[dir(x,p)];moveTo[p]=true;
+   bridgeReport.push_back({turn,3,h,c.tube,x,p,0});
+  }else bridgeReport.push_back({turn,4,h,c.tube,x,x,0}); // defensive only
+ }
+ void maybeStartBridge(const vector<int>& ready,bitset<V>& used,
+     const bitset<V>& build,bitset<V>& moveTo,const bitset<V>& pairedTubes){
+  if(crossing.actor>=0||turn<101||turn>152||
+     any_of(ready.begin(),ready.end(),[](int q){return !q;}))return;
+  const auto lane=[&](int p){return bankRot?p/S:p%S;};
+  array<bool,V> occ{};
+  array<int,S> pop{};
+  for(int p:humans)occ[p]=true,++pop[lane(p)];
+  for(Pet p:pets)occ[p.p]=true;
+  const auto open=[&](const TubeBank& q){
+   return !wall[q.g]&&!wall[q.k]&&!build[q.g]&&!build[q.k]&&
+    none_of(q.inner.begin(),q.inner.end(),[&](int p){return wall[p]||build[p];});
+  };
+  int best=0,i0=-1,m0=-1,dir0=0;
+  for(int i=0;i<int(banks.size());i++){
+   const auto& x=banks[i];
+   if(pairedTubes[i]||!open(x)||occ[x.g]||occ[x.k]||
+     any_of(x.inner.begin(),x.inner.end(),[&](int p){return occ[p];}))continue;
+   for(int a=0;a<2;a++){
+    int f=a?x.h:x.l,e=a?x.l:x.h;
+    if(pop[lane(e)]||pop[lane(f)]<2)continue;
+    int supply=0;
+    for(int j=0;j<int(banks.size());j++)if(j!=i&&open(banks[j])){
+     auto& y=banks[j];
+     supply+=((lane(y.l)==lane(e)&&md(y.l,e)<=3)||(lane(y.h)==lane(e)&&md(y.h,e)<=3));
+    }
+    if(supply<=best)continue;
+    for(int m=0;m<int(humans.size());m++)
+     if(!used[m]&&act[m]=='.'&&humans[m]==f){
+      best=supply;i0=i;m0=m;dir0=a;break;
+     }
+   }
+  }
+  if(i0<0)return;
+  const auto& x=banks[i0];
+  crossing={m0,i0,{x.l,x.g,x.inner[0],x.inner[1],x.inner[2],x.inner[3],x.k,x.h},false};
+  if(dir0)reverse(crossing.route.begin(),crossing.route.end());
+  bridgeReport.push_back({turn,0,m0,i0,crossing.route.front(),crossing.route.back(),best});
+  continueBridge(used,moveTo);
+ }
