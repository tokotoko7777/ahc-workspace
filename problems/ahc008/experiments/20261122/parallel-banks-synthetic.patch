+ for(int x=0;x<S;x++)for(int y=0;y<S;y++)
+  nb[pos(x,y)]={x?pos(x-1,y):-1,x<S-1?pos(x+1,y):-1,y?pos(x,y-1):-1,y<S-1?pos(x,y+1):-1};
+ int a=pos(5,5),b=pos(5,6),c=pos(5,7),d=pos(5,8),e=pos(5,9);
