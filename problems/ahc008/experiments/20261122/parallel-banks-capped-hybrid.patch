+ CapInfo capInfo(const TubeBank& x)const{
+  if(!sparseCaps)return {};
+  int i=(x.r-3)/2;
+  if((i+x.b)%3!=1)return {};
+  if((i/3+x.b)%2==0)return {x.g,x.k,x.l,x.h,x.b+1};
+  return {x.k,x.g,x.h,x.l,x.b};
+ }
+ void steerSingles(const vector<int>& ready,const vector<int>& viable,const bitset<V>& build,bitset<V>& moveTo,bitset<16>* use){
+  if(!sparseCaps)return;
