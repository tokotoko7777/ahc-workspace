+   const auto &x=banks[i];auto c=capInfo(x);
+   if(c.shut<0||!ready[i]||!wall[c.shut]||wall[c.open]||build[c.open])continue;
+   int worker=zonesActive?zoneCrew[x.r>=14][c.openLane]:laneCrew[c.openLane];
+   if(worker<0||capHeld[worker]||act[worker]!='.')continue;
+   int d=workers[worker].bfs.distance(c.openStance);
+   if(d<0||d>19)continue;
+   double val=0.;
+   for(auto p:pets){
+    if(group[p.p]!=group[c.openStance])continue;
+    if(p.t==4&&find(x.inner.begin(),x.inner.end(),p.p)==x.inner.end())continue;
+    int dist=min(md(p.p,x.inner[1]),md(p.p,x.inner[2]));
+    if(dist>6+d/2)continue;
+    if(dist==0)val+=d<=1?12.:6.;
+    else val+=(p.t>=3?3.7:4.8)/(1.+.65*dist+.14*dist*dist);
+   }
+   val=(val+(viable[i]?2.0:0.))/(2.+.63*d);
+   if(val>.20)picks.emplace_back(val,-i,-worker);
+  }
+  sort(picks.rbegin(),picks.rend());
+  for(auto [v,j,k]:picks){
+   int i=-j,w=-k;
+   if(capHeld[w]||act[w]!='.')continue;
+   auto c=capInfo(banks[i]);
+   int q=workers[w].bfs.first_step(c.openStance),h=humans[w];
+   if(q<0||build[q])continue;
+   if(q!=h)act[w]=MOVE[dir(h,q)],moveTo[q]=1;
+   capHeld[w]=1;if(use)(*use)[w]=1;
+  }
+ }
