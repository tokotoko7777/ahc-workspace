+inline std::optional<std::string> composeTeam(Planner& kept,Planner&& trial,
+ const Board& wall,const std::vector<int>& humans,const std::vector<Pet>& pets,
+ const std::string& ordinary,const std::string& proposal){
+ assert(humans.size()==ordinary.size()&&humans.size()==proposal.size());
+ auto orig=Planner::walkable(wall);
+ BFS f;f.run(humans[0],orig);
+ Board root{};
+ for(int i=0;i<V;i++)root[i]=f.d[i]>=0;
+ auto blocked=Planner::occupied(humans,pets);
+ Board merged=wall;
+ std::vector<int> after=humans;
+ std::string used=ordinary;
+ for(int i=0;i<(int)used.size();i++){
+  if(trial.teamAllowed(i))used[i]=proposal[i];
+  char c=used[i];if(c=='.')continue;
+  const auto chars=c>='a'?BUILD:MOVE;
+  int d=std::find(chars,chars+4,c)-chars;
+  if(d>=4)return std::nullopt;
+  int q=neighbors(humans[i])[d];
+  if(q<0||wall[q])return std::nullopt;
+  if(c>='a'){
+   if(blocked[q]||merged[q])return std::nullopt;
+   merged[q]=1;
+  }else after[i]=q;
+ }
+ for(int q:after)if(merged[q])return std::nullopt;
+ // All merged moves must lie in the actual retained component when
+ // the whole candidate is eventually built; includes all p2 walls.
+ if(!Planner::certify(trial.active,merged,after,pets,root)
+      ||!trial.certifyTeam(trial.active,merged,pets,root))return std::nullopt;
+ kept=std::move(trial);
+ return used;
+}
