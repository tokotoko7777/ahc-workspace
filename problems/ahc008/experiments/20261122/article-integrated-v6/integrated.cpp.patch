+  unsigned mask=0;
+  for(int i=0;i<(int)p1.size();i++)if(p1[i])mask|=1u<<i;
+  if(!mask)return ordinary;
+  auto trial=earlyCrew;
+  if(!earlyConsidered){
+   earlyConsidered=true;
+   int id=-1,best=999;
+   int cx=target>=0?pockets[target].cx:humans[std::countr_zero(mask)];
+   int root=group[humans[std::countr_zero(mask)]];
+   for(int i=0;i<(int)pets.size();i++)if(group[pets[i].p]==root){
+    int d=workers[std::countr_zero(mask)].bfs.distance(pets[i].p);
+    if(d<0)continue;
+    int key=3*md(pets[i].p,cx)+d;
+    if(key<best)best=key,id=i;
+   }
+   if(id<0)return ordinary;
+   trial.teamFocus=id;
+   trial.teamDeadline=205;
+   trial.cfg.start=160;
+   trial.cfg.maxAttempt=45;
+   trial.cfg.maxTotal=45;
+  }else if(earlyCrew.began<0)return ordinary;
+  trial.teamMask=mask;
+  int id=trial.teamFocus;
+  vector<lastcap::Pet> animals;
+  for(auto p:pets)animals.push_back({p.p,p.t});
+  auto proposal=trial.plan(turn,wall,humans,animals);
+  if(!proposal){
+   earlyTrace.push_back({turn,trial.attempts?3:0,id,0,(int)mask,earlyCrew.placed,earlyCrew.total,ordinary,ordinary});
+   if(earlyCrew.began>=0)earlyCrew=std::move(trial); // abort, no hypothetical install
+   return ordinary;
+  }
+  if(auto merged=lastcap::composeTeam(earlyCrew,std::move(trial),wall,humans,animals,ordinary,*proposal)){
+   earlyTrace.push_back({turn,1,id,earlyCrew.teamArea,(int)mask,earlyCrew.placed,earlyCrew.total,ordinary,*merged});
+   return *merged;
+  }
+  earlyTrace.push_back({turn,2,id,0,(int)mask,earlyCrew.placed,earlyCrew.total,ordinary,ordinary});
+  return ordinary;
+ }
