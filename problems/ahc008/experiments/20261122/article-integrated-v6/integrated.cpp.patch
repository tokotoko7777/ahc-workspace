+ bool certifyTeam(const Shape& z,const Board& wall,const std::vector<Pet>& pets,const Board& root){
+  if(!teamMode())return true;
+  int focus=pets[teamFocus].p;
+  if(!root[focus]||z.can[focus])return false;
+  Board op=walkable(wall);
+  for(int p:z.cut)op[p]=0;
+  BFS b;
+  const int area=b.run(focus,op);
+  if(area<4||area>48)return false;
+  int loR=S,hiR=-1,loC=S,hiC=-1;
+  for(int p=0;p<V;p++)if(b.d[p]>=0){
+   loR=std::min(loR,p/S);hiR=std::max(hiR,p/S);
+   loC=std::min(loC,p%S);hiC=std::max(hiC,p%S);
+  }
+  if(area==(hiR-loR+1)*(hiC-loC+1))return false;
+  teamArea=area;
+  // No extra large animal compartment may hide behind a small target pen.
+  for(auto p:pets)if(root[p.p]&&!z.can[p.p]&&b.d[p.p]<0){
+   BFS component;
+   const int other=component.run(p.p,op);
+   if(other<=0||other>48)return false;
+  }
+  return true;
+ }
