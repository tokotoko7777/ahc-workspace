+// Score units are milli-pets. 'certain' counts legally closable pets now,
+// not projected ones. 'value' includes future capture, travel and churn.
+struct Order {
+    int tube, leftLane, rightLane, leftWorker, rightWorker;
+    int certain, value;
+};
+struct Chosen {
+    int certain=0, value=0;
+    std::vector<Order> orders;
+};
+inline Chosen choose(int workers, const std::vector<std::vector<Order>>& byTube) {
+    // One option per tube; a bit per human covers shared lanes and permits
+    // independent stations when a lane actually has two humans.
+    struct Score { int certain=-1,value=0; };
+    auto better=[](Score a, Score b){return a.certain>b.certain || (a.certain==b.certain&&a.value>b.value);};
+    const int states=1<<workers;
+    std::vector<Score> dp(states), next(states);
+    std::vector<std::vector<std::pair<int,int>>> origin(byTube.size(),std::vector<std::pair<int,int>>(states,{-1,-1}));
+    dp[0]={0,0};
+    for (int t=0;t<(int)byTube.size();++t) {
+        next=dp;
+        for(int m=0;m<states;++m)if(dp[m].certain>=0)origin[t][m]={m,-1};
+        for (int k=0;k<(int)byTube[t].size();++k) {
+            const auto &o=byTube[t][k];
+            if(o.leftWorker==o.rightWorker||o.leftWorker<0||o.rightWorker<0||
+               o.leftWorker>=workers||o.rightWorker>=workers||(!o.certain&&o.value<=0))continue;
+            const int bits=(1<<o.leftWorker)|(1<<o.rightWorker);
+            for(int m=0;m<states;++m)if(dp[m].certain>=0&&!(m&bits)){
+                Score newScore{dp[m].certain+o.certain,dp[m].value+o.value};
+                if(better(newScore,next[m|bits])){
+                    next[m|bits]=newScore; origin[t][m|bits]={m,k};
+                }
+            }
+        }
+        dp.swap(next);
+    }
+    int m=0;
+    for(int i=0;i<states;++i)if(better(dp[i],dp[m]))m=i;
+    Chosen result{dp[m].certain,dp[m].value,{}};
+    for(int t=(int)byTube.size()-1;t>=0;--t){
+        auto [prev,k]=origin[t][m];
+        if(k>=0)result.orders.push_back(byTube[t][k]);
+        m=prev;
+    }
+    std::reverse(result.orders.begin(),result.orders.end());
+    return result;
+}
+// Distribution over the four interior cells plus the two mouths; mass
+// stepping into an outer lane is discarded. Use observed first-passage
+// transitions or the actual local graph when evaluating a real tube.
+inline double unbiased_mobile_forecast(int x, int stride, int eta, int patience) {
+    if(x<0||x>5||stride<1)return 0.;
+    std::array<double,6> state{}; state[x]=1.;
+    double capture=0;
+    for(int turn=0;turn<=eta+patience;++turn){
+        if(turn>=eta){
+            // [0] and [5] are gates, [1] and [4] are adjacent to their gate.
+            capture+=state[2]+state[3]; state[2]=state[3]=0.;
+        }
+        for(int k=0;k<stride;++k){
+            std::array<double,6> next{};
+            for(int j=0;j<6;++j){
+                if(j>0)next[j-1]+=state[j]*.5;
+                if(j<5)next[j+1]+=state[j]*.5;
+            }
+            state=next;
+        }
+    }
+    return capture;
+}
+// Fixed ETA forecast from marginal states. safe = inside far enough from
+// both gates; blocks = in a gate or any 4-neighbor of either gate.
+// Independence is an approximation for ranking preparations, never used
+// to legalize a build. In particular, a second pet at a mouth vetoes it.
+struct Mass { double safe, blocks; };
+struct Forecast { double pClose, expected; };
+inline Forecast joint(const std::vector<Mass>& pets) {
+    double clear=1., nothing=1., expected=0.;
+    for (int i=0;i<(int)pets.size();++i) {
+        const auto m=pets[i];
+        clear*=1.-m.blocks;
+        nothing*=1.-m.blocks-m.safe;
+        double x=m.safe;
+        for (int j=0;j<(int)pets.size();++j)if(i!=j)x*=1.-pets[j].blocks;
+        expected+=x;
+    }
+    return {std::max(0.,clear-nothing),expected};
+}
