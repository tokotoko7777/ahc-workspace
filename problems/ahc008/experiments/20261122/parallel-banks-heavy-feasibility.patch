+ bool heavyAudit=false;
+ struct HeavyAuditStat {int nominal=0,exact=0,assign=0,best=0,bestYield=0;};
+ bool multiNominal(const Pen& pen) const{
+  int n=0;
+  for(auto p:pets)if(group[p.p]==group[humans[0]]&&find(pen.inside.begin(),pen.inside.end(),p.p)!=pen.inside.end())
+   if(++n>=2)return true;
+  return false;
