+ pair<int,int> multiFeasible(const Pen& pen,const vector<bool>& eligible,HeavyAuditStat& stat){
+  if(!multiNominal(pen))return {0,0};
+  ++stat.nominal;
+  int a=humans[0],g=group[a];
+  for(int h:humans)if(group[h]!=g)return {0,0};
+  vector<int> jobs;
+  bitset<V> ban;
+  for(int p:pen.wall)if(!wall[p])jobs.push_back(p),ban[p]=1;
+  if(jobs.empty()||jobs.size()>6||ban[a])return {0,0};
+  bitset<V> retained;
+  int q[V],n=1;q[0]=a;retained[a]=1;
+  for(int j=0;j<n;j++)for(int p:nb[q[j]])if(p>=0&&!wall[p]&&!ban[p]&&!retained[p])q[n++]=p,retained[p]=1;
+  if(n<200||100*n<65*currentCt[g])return {0,0};
+  for(int h:humans)if(!retained[h])return {0,0};
+  int animals=0;for(auto p:pets)if(group[p.p]==g&&!retained[p.p]&&find(pen.inside.begin(),pen.inside.end(),p.p)!=pen.inside.end())++animals;
+  if(animals<2)return {0,0};
+  ++stat.exact;
+  unsigned admitted[6]{};
+  for(int i=0;i<int(humans.size());i++)if(eligible[i]){
+   array<int,V> d;d.fill(-1);q[0]=humans[i];d[q[0]]=0;int m=1;d[q[0]]=0;
+   for(int j=0;j<m;j++)if(d[q[j]]<5)for(int v:nb[q[j]])
+    if(v>=0&&retained[v]&&d[v]<0)q[m++]=v,d[v]=d[q[j]]+1;
+   for(int j=0;j<int(jobs.size());j++)for(int v:nb[jobs[j]])
+    if(v>=0&&d[v]>=0)admitted[j]|=1u<<i;
+  }
+  auto match=[&](auto&& self,int j,unsigned used)->bool{
+   if(j==int(jobs.size()))return true;
+   for(unsigned avail=admitted[j]&~used;avail;avail&=avail-1){
+    if(self(self,j+1,used|(avail&-avail)))return true;
+   }
+   return false;
+  };
+  if(!match(match,0,0))return {0,0};
+  ++stat.assign;stat.best=max(stat.best,animals);stat.bestYield=max(stat.bestYield,animals*1000/int(jobs.size()));
+  return {animals,int(jobs.size())};
+ }
